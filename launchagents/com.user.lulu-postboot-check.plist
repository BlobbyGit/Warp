<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.user.lulu-postboot-check</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-c</string>
		<string>sleep 45; "$HOME/lulu-postboot-check.sh" &gt; "$HOME/lulu-postboot-check.log" 2&gt;&amp;1; launchctl bootout "gui/$(id -u)/com.user.lulu-postboot-check" 2&gt;/dev/null; rm -f "$HOME/Library/LaunchAgents/com.user.lulu-postboot-check.plist"</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
