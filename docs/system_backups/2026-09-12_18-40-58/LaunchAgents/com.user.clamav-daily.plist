<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.clamav-daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/jarrodstebbing/Warp/scripts/clamav_daily_scan.sh</string>
    </array>

    <!-- 12:30 daily. Deliberately not 09:00: com.syscheck.daily and
         com.user.systemcheck both already fire then. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>12</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <!-- Do not kick off a long scan every time the agent is loaded or the
         user logs in; wait for the scheduled slot. -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Keep the scan out of the way of interactive work. -->
    <key>Nice</key>
    <integer>19</integer>

    <key>LowPriorityIO</key>
    <true/>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/tmp/com.user.clamav-daily.out.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/com.user.clamav-daily.err.log</string>
</dict>
</plist>
